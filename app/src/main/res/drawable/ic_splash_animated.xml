<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp"
            android:height="432dp"
            android:viewportWidth="432"
            android:viewportHeight="432">
            
            <!-- 外圈神经拓扑环 (旋转放大动效) -->
            <group
                android:name="cortex_ring"
                android:pivotX="216"
                android:pivotY="216"
                android:scaleX="0.6"
                android:scaleY="0.6"
                android:rotation="0">
                <path
                    android:pathData="M216,88 C286.69,88 344,145.31 344,216 C344,286.69 286.69,344 216,344 C145.31,344 88,286.69 88,216 C88,145.31 145.31,88 216,88 Z"
                    android:strokeWidth="3"
                    android:strokeAlpha="0.35"
                    android:strokeColor="#FF38BDF8" />
                <!-- 6 个节点 -->
                <path
                    android:pathData="M216,84 A4,4 0 1,1 216,92 A4,4 0 1,1 216,84"
                    android:fillColor="#FF67E8F9" />
                <path
                    android:pathData="M327,152 A4,4 0 1,1 327,160 A4,4 0 1,1 327,152"
                    android:fillColor="#FF38BDF8" />
                <path
                    android:pathData="M327,272 A4,4 0 1,1 327,280 A4,4 0 1,1 327,272"
                    android:fillColor="#FF0284C7" />
                <path
                    android:pathData="M216,340 A4,4 0 1,1 216,348 A4,4 0 1,1 216,340"
                    android:fillColor="#FF67E8F9" />
                <path
                    android:pathData="M105,272 A4,4 0 1,1 105,280 A4,4 0 1,1 105,272"
                    android:fillColor="#FF0284C7" />
                <path
                    android:pathData="M105,152 A4,4 0 1,1 105,160 A4,4 0 1,1 105,152"
                    android:fillColor="#FF38BDF8" />
            </group>

            <!-- 中心 Cortex 神经折叠外壳与核心 (缩放弹出动效) -->
            <group
                android:name="cortex_core"
                android:pivotX="216"
                android:pivotY="216"
                android:scaleX="0"
                android:scaleY="0">
                <!-- 左翼皮层瓣 -->
                <path
                    android:pathData="M216,137 L151,175 L151,257 L216,295 L194,245 L173,216 L194,187 Z"
                    android:strokeAlpha="0.95"
                    android:strokeColor="#FF0284C7"
                    android:strokeWidth="2">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="151"
                            android:startY="175"
                            android:endX="216"
                            android:endY="295"
                            android:startColor="#FF0284C7"
                            android:endColor="#FF0C4A6E" />
                    </aapt:attr>
                </path>

                <!-- 右翼皮层瓣 -->
                <path
                    android:pathData="M216,137 L281,175 L281,257 L216,295 L238,245 L259,216 L238,187 Z"
                    android:strokeAlpha="0.95"
                    android:strokeColor="#FF38BDF8"
                    android:strokeWidth="2">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="281"
                            android:startY="175"
                            android:endX="216"
                            android:endY="295"
                            android:startColor="#FF38BDF8"
                            android:endColor="#FF164E63" />
                    </aapt:attr>
                </path>

                <!-- 中央高亮晶体菱形主脑核心 -->
                <path
                    android:pathData="M216,165 L252,216 L216,267 L180,216 Z"
                    android:strokeColor="#FF67E8F9"
                    android:strokeWidth="2">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="216"
                            android:startY="165"
                            android:endX="216"
                            android:endY="267"
                            android:startColor="#FF67E8F9"
                            android:endColor="#FF0284C7" />
                    </aapt:attr>
                </path>

                <!-- 内部神经脉冲微晶焦点 -->
                <path
                    android:pathData="M216,194 L232,216 L216,238 L200,216 Z"
                    android:fillColor="#FFFFFFFF" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 动画控制器：核心弹性放大弹出 -->
    <target android:name="cortex_core">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="400"
                    android:startOffset="40"
                    android:valueFrom="0.2"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:propertyName="scaleX"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:duration="400"
                    android:startOffset="40"
                    android:valueFrom="0.2"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:propertyName="scaleY"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- 拓扑外环微旋与放大 -->
    <target android:name="cortex_ring">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="480"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:propertyName="scaleX"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:duration="480"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:propertyName="scaleY"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:duration="600"
                    android:valueFrom="0"
                    android:valueTo="60"
                    android:valueType="floatType"
                    android:propertyName="rotation"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
